    "minimatch": "^9.0.3",
    "node-cron": "^3.0.3",
    "turndown": "^7.1.2",
    "winston": "^3.11.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
